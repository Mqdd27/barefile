# Copy to .env (scripts/setup-macos.sh does this and generates the secret).

# Required. Signs session cookies. Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
FILEMANAGER_SECRET_KEY=

# Folder served by the app. Everything outside it is unreachable.
#FILEMANAGER_STORAGE_ROOT=./data/storage

# Database, Recycle Bin and upload temp files. Must not overlap the storage root
# and must be on the same filesystem as it.
#FILEMANAGER_DATA_DIR=./data/app

# Set to 1 behind HTTPS so session cookies are never sent over plain HTTP.
#FILEMANAGER_COOKIE_SECURE=0

# Where native commands are looked up. Pinned so PATH cannot change the binaries.
#FILEMANAGER_CLI_PATH=/usr/bin:/bin

# Seconds. Short commands (ls, stat, du, find, ...) and long ones (cp, rm).
#FILEMANAGER_CMD_TIMEOUT=30
#FILEMANAGER_OP_TIMEOUT=3600

# Bytes per file. Default 10 GiB. 0 disables the limit.
#FILEMANAGER_MAX_UPLOAD=10737418240
